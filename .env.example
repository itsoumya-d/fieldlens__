EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Error Monitoring
EXPO_PUBLIC_SENTRY_DSN=

# Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=

# Supabase PgBouncer connection pooler (Transaction mode)
# Get from: Supabase Dashboard → Settings → Database → Connection pooling → Transaction mode
# Use this URL in any direct pg/Prisma connections for connection pooling
DATABASE_POOLER_URL=postgresql://postgres.your-project:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Optional native services (leave unset when only validating a web export)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_PROJECT_ID=
