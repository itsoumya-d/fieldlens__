{
  "expo": {
    "name": "FieldLens",
    "slug": "fieldlens",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldlens",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1C1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fieldlens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FieldLens uses your camera to analyze your work and provide AI coaching.",
        "NSMicrophoneUsageDescription": "FieldLens uses your microphone for voice commands during AI coaching."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C1C1E"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "package": "com.fieldlens.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FieldLens to access your camera for AI coaching."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
